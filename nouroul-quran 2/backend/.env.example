# Base de données (par défaut : SQLite local)
DATABASE_URL=sqlite:///nouroul_quran.db

# Origine autorisée pour le frontend (séparer par des virgules si plusieurs)
FRONTEND_ORIGIN=http://localhost:5173

# Clé pour consulter GET /api/contact (à changer en production)
ADMIN_API_KEY=changeme

# Configuration SMTP pour l'envoi de l'e-mail de notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse@gmail.com
SMTP_PASSWORD=mot-de-passe-application
NOTIFY_EMAIL=contact@nouroulquran.org

PORT=5000
