# Base de données (par défaut : SQLite local)
DATABASE_URL=sqlite:///nouroul_quran.db

# Origine autorisée pour le frontend (séparer par des virgules si plusieurs)
FRONTEND_ORIGIN=http://localhost:5173

# Clé de connexion au dashboard admin (obligatoire, longue et aléatoire)
ADMIN_API_KEY=remplace-moi-par-une-cle-longue-et-aleatoire

# Facultatif : mot de passe du compte utilisateur initial créé par seed.py
INITIAL_ADMIN_PASSWORD=

PORT=5000
